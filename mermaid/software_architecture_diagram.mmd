    Compare --> Evaluator

    RuleBased --> CostOpt
    RuleBased --> RelOpt
    RuleBased --> Hybrid
    RuleBased --> WorkloadAware
    RuleBased --> Threshold

    CloudGym --> CloudEnv
    CloudEnv --> Services
    CloudEnv --> Workloads

    Services --> EC2OnDemand
    Services --> EC2Spot
    Services --> Lambda
    Services --> Fargate

    Workloads --> Diurnal
    Workloads --> Steady
    Workloads --> Batch
    Workloads --> Bursty

    CloudEnv --> State
    CloudEnv --> History
    CloudEnv --> Config

    TrainDQN --> Models
    Evaluator --> Results
    Evaluator --> Plots

    StableBaselines --> Gymnasium
    StableBaselines --> PyTorch
    CloudGym --> Gymnasium

    %% External Data Flow
    Services -.-> AWS
    Services -.-> PricingAPI
    Workloads -.-> WorkloadData

